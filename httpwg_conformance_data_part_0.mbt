            params: [],
          }),
        ),
      ]),
    ),
  },
  {
    name: "Example-DictHeader (boolean valu" + "es)",
    header_type: "dictionary",
    raw: ["a=?0, b, c; foo=bar"],
    must_fail: false,
    can_fail: false,
    canonical: Some(["a=?0, b, c;foo=bar"]),
    expected: Some(
      ExpDictField([
        ("a", ExpItemMember({ bare: ExpBoolean(false), params: [] })),
        ("b", ExpItemMember({ bare: ExpBoolean(true), params: [] })),
        (
          "c",
          ExpItemMember({
            bare: ExpBoolean(true),
            params: [{ key: "foo", value: ExpToken("bar") }],
          }),
        ),
      ]),
    ),
  },
