    canonical: Some(["a=(1 2), b=3, c=4;aa=bb, d=(5 6)" + ";valid"]),
    expected: Some(
      ExpDictField([
        (
          "a",
          ExpInnerList(
            [
              { bare: ExpInteger(1L), params: [] },
              { bare: ExpInteger(2L), params: [] },
            ],
            [],
          ),
        ),
        ("b", ExpItemMember({ bare: ExpInteger(3L), params: [] })),
        (
          "c",
          ExpItemMember({
            bare: ExpInteger(4L),
            params: [{ key: "aa", value: ExpToken("bb") }],
          }),
        ),
        (
          "d",
          ExpInnerList(
            [
              { bare: ExpInteger(5L), params: [] },
              { bare: ExpInteger(6L), params: [] },
            ],
            [{ key: "valid", value: ExpBoolean(true) }],
          ),
        ),
      ]),
    ),
