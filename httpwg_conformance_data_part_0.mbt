    must_fail: false,
    can_fail: false,
    canonical: None,
    expected: Some(
      ExpListField([
        ExpInnerList(
          [
            { bare: ExpString("foo"), params: [] },
            { bare: ExpString("bar"), params: [] },
          ],
          [],
        ),
        ExpInnerList([{ bare: ExpString("baz"), params: [] }], []),
        ExpInnerList(
          [
            { bare: ExpString("bat"), params: [] },
            { bare: ExpString("one"), params: [] },
          ],
          [],
        ),
        ExpInnerList([], []),
      ]),
    ),
  },
  {
    name: "Example-ListListParam",
    header_type: "list",
    raw: ["(\"foo\"; a=1;b=2);lvl=5, (\"bar\" \"" + "baz\");lvl=1"],
    must_fail: false,
    can_fail: false,
    canonical: Some(["(\"foo\";a=1;b=2);lvl=5, (\"bar\" \"b" + "az\");lvl=1"]),
    expected: Some(
      ExpListField([
        ExpInnerList(
          [
            {
              bare: ExpString("foo"),
              params: [
                { key: "a", value: ExpInteger(1L) },
                { key: "b", value: ExpInteger(2L) },
              ],
            },
          ],
          [{ key: "lvl", value: ExpInteger(5L) }],
        ),
        ExpInnerList(
          [
            { bare: ExpString("bar"), params: [] },
            { bare: ExpString("baz"), params: [] },
          ],
          [{ key: "lvl", value: ExpInteger(1L) }],
        ),
      ]),
    ),
  },
  {
    name: "Example-ParamListHeader",
    header_type: "list",
    raw: ["abc;a=1;b=2; cde_456, (ghi;jk=4 " + "l);q=\"9\";r=w"],
    must_fail: false,
    can_fail: false,
    canonical: Some(["abc;a=1;b=2;cde_456, (ghi;jk=4 l" + ");q=\"9\";r=w"]),
    expected: Some(
      ExpListField([
        ExpItemMember({
          bare: ExpToken("abc"),
          params: [
            { key: "a", value: ExpInteger(1L) },
            { key: "b", value: ExpInteger(2L) },
            { key: "cde_456", value: ExpBoolean(true) },
          ],
        }),
        ExpInnerList(
          [
            {
              bare: ExpToken("ghi"),
              params: [{ key: "jk", value: ExpInteger(4L) }],
            },
            { bare: ExpToken("l"), params: [] },
          ],
          [
            { key: "q", value: ExpString("9") },
            { key: "r", value: ExpToken("w") },
          ],
        ),
      ]),
    ),
  },
  {
    name: "Example-IntHeader",
    header_type: "item",
    raw: ["1; a; b=?0"],
    must_fail: false,
    can_fail: false,
    canonical: Some(["1;a;b=?0"]),
    expected: Some(
      ExpItemField({
        bare: ExpInteger(1L),
        params: [
          { key: "a", value: ExpBoolean(true) },
          { key: "b", value: ExpBoolean(false) },
        ],
      }),
    ),
  },
]

