      ExpDictField([
        ("rating", ExpItemMember({ bare: ExpDecimal(15L, 1), params: [] })),
        (
          "feelings",
          ExpInnerList(
            [
              { bare: ExpToken("joy"), params: [] },
              { bare: ExpToken("sadness"), params: [] },
            ],
            [],
          ),
        ),
      ]),
    ),
  },
  {
    name: "Example-MixDict",
    header_type: "dictionary",
    raw: ["a=(1 2), b=3, c=4;aa=bb, d=(5 6)" + ";valid"],
