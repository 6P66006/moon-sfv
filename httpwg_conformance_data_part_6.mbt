        ),
      ]),
    ),
  },
  {
    name: "trailing comma parameterised lis" + "t",
    header_type: "dictionary",
    raw: ["a=b; q=1.0,"],
    must_fail: true,
    can_fail: false,
    canonical: None,
    expected: None,
  },
  {
    name: "empty item parameterised list",
    header_type: "dictionary",
    raw: ["a=b; q=1.0,,c=d"],
    must_fail: true,
    can_fail: false,
    canonical: None,
    expected: None,
  },
  {
    name: "basic parameterised list",
    header_type: "list",
    raw: ["abc_123;a=1;b=2; cdef_456, ghi;q" + "=9;r=\"+w\""],
    must_fail: false,
    can_fail: false,
    canonical: Some(["abc_123;a=1;b=2;cdef_456, ghi;q=" + "9;r=\"+w\""]),
    expected: Some(
      ExpListField([
        ExpItemMember({
          bare: ExpToken("abc_123"),
          params: [
            { key: "a", value: ExpInteger(1L) },
            { key: "b", value: ExpInteger(2L) },
            { key: "cdef_456", value: ExpBoolean(true) },
          ],
        }),
        ExpItemMember({
          bare: ExpToken("ghi"),
          params: [
            { key: "q", value: ExpInteger(9L) },
            { key: "r", value: ExpString("+w") },
          ],
        }),
      ]),
    ),
  },
  {
    name: "single item parameterised list",
    header_type: "list",
    raw: ["text/html;q=1.0"],
    must_fail: false,
    can_fail: false,
    canonical: None,
    expected: Some(
      ExpListField([
        ExpItemMember({
          bare: ExpToken("text/html"),
          params: [{ key: "q", value: ExpDecimal(10L, 1) }],
        }),
      ]),
    ),
  },
  {
    name: "missing parameter value paramete" + "rised list",
    header_type: "list",
    raw: ["text/html;a;q=1.0"],
    must_fail: false,
    can_fail: false,
    canonical: None,
    expected: Some(
      ExpListField([
        ExpItemMember({
          bare: ExpToken("text/html"),
          params: [
            { key: "a", value: ExpBoolean(true) },
            { key: "q", value: ExpDecimal(10L, 1) },
          ],
        }),
      ]),
    ),
  },
  {
    name: "missing terminal parameter value" + " parameterised list",
    header_type: "list",
    raw: ["text/html;q=1.0;a"],
    must_fail: false,
    can_fail: false,
    canonical: None,
    expected: Some(
      ExpListField([
        ExpItemMember({
          bare: ExpToken("text/html"),
          params: [
            { key: "q", value: ExpDecimal(10L, 1) },
            { key: "a", value: ExpBoolean(true) },
          ],
        }),
      ]),
    ),
  },
]

